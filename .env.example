DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# False на сервере, где /static/ обслуживает Nginx; не зависит от DJANGO_DEBUG.
DJANGO_SERVE_STATIC=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Локальный PostgreSQL: make db-start выведет URL с абсолютным путём сокета.
# Замените /absolute/path/to/LHEC на путь к своему проекту.
DATABASE_URL=postgresql://lhec_dev@/lhec_dev?host=/absolute/path/to/LHEC/.local/postgres/socket
# TCP (например, PostgreSQL на localhost):
# DATABASE_URL=postgresql://lhec:password@127.0.0.1:5432/lhec
# Jail: каталог должен совпадать с unix_socket_directories PostgreSQL.
# DATABASE_URL=postgresql://lhec:password@/lhec?host=/var/run/postgresql

# Django admin data
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=adminadmin

# Хранилища файлов (на сервере укажите постоянные абсолютные пути вне кода).
# STATIC_ROOT=/var/www/lhec/staticfiles
# MEDIA_ROOT=/var/db/lhec/media
# PRIVATE_PUBLICATIONS_ROOT=/var/db/lhec/private
