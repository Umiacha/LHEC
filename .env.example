DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# False на сервере, где /static/ обслуживает Nginx; не зависит от DJANGO_DEBUG.
DJANGO_SERVE_STATIC=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для локального HTTP оставьте значения ниже; production-пример — в README.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# True только за доверенным прокси, перезаписывающим X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
# Только осознанные исключения W004/W005/W008/W021; см. README.
DJANGO_SILENCED_SECURITY_CHECKS=
# Выделенная локальная MySQL-БД: make db-prepare, затем make migrate.
# Учётную запись и права на lhecdev/test_lhecdev заранее выдаёт администратор.
# Замените пароль; спецсимволы кодируйте для URL.
# Unix-сокет Ubuntu (путь в host закодирован для URL):
DATABASE_URL=mysql://lhec_dev:replace-with-local-password@%2Frun%2Fmysqld%2Fmysqld.sock/lhecdev
# Альтернатива по TCP:
# DATABASE_URL=mysql://lhec_dev:password@127.0.0.1:3306/lhecdev

# Только для локального make create-test-admin.
# На сервере удалите эти переменные и выполните make -f Makefile.prod create-superuser.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=adminadmin

# Хранилища файлов (на сервере укажите постоянные абсолютные пути вне кода).
# STATIC_ROOT=/var/www/lhec/staticfiles
# MEDIA_ROOT=/var/db/lhec/media
# PRIVATE_PUBLICATIONS_ROOT=/var/db/lhec/private
